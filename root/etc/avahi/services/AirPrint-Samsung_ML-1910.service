<?xml version="1.0" ?>
<!DOCTYPE service-group SYSTEM "avahi-service.dtd">
<service-group>
  <name replace-wildcards="yes">AirPrint Samsung_ML-1910 @ %h</name>
  <service>
    <type>_ipp._tcp</type>
    <subtype>_universal._sub._ipp._tcp</subtype>
    <port>631</port>
    <txt-record>txtvers=1</txt-record>
    <txt-record>qtotal=1</txt-record>
    <txt-record>Transparent=T</txt-record>
    <txt-record>URF=none</txt-record>
    <txt-record>rp=printers/Samsung_ML-1910</txt-record>
    <txt-record>note=Samsung ML-1910 Mono Laser</txt-record>
    <txt-record>product=(Samsung ML-1910)</txt-record>
    <txt-record>printer-state=3</txt-record>
    <txt-record>printer-type=0xC0000C</txt-record>
    <txt-record>Color=F</txt-record>
    <txt-record>pdl=application/octet-stream,application/pdf,application/postscript,application/vnd.cups-raster,image/jpeg,image/png,image/tiff,text/plain</txt-record>
  </service>
</service-group>
